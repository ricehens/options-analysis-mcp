# Keep fake enabled for deterministic local development. Add "schwab" only when
# you are ready to configure that adapter.
OPTIONS_ANALYSIS_ENVIRONMENT=development
OPTIONS_ANALYSIS_ENABLED_PROVIDERS=["fake"]
OPTIONS_ANALYSIS_DEFAULT_MARKET_DATA_PROVIDER=fake
OPTIONS_ANALYSIS_ALLOW_LIVE_SMOKE_TESTS=false

# Copy this file to the ignored .env file and fill these values locally. The
# redirect URI must exactly match the callback registered in Schwab's portal.
OPTIONS_ANALYSIS_SCHWAB_CLIENT_ID=
OPTIONS_ANALYSIS_SCHWAB_CLIENT_SECRET=
OPTIONS_ANALYSIS_SCHWAB_REDIRECT_URI=https://127.0.0.1

# Optional overrides. The default token file is outside this repository at
# ~/Library/Application Support/options-analysis-mcp/schwab-token.json.
# OPTIONS_ANALYSIS_SCHWAB_TOKEN_PATH=/absolute/private/path/schwab-token.json
# OPTIONS_ANALYSIS_SCHWAB_AUTHORIZATION_URL=https://api.schwabapi.com/v1/oauth/authorize
# OPTIONS_ANALYSIS_SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token
# OPTIONS_ANALYSIS_SCHWAB_MARKET_DATA_BASE_URL=https://api.schwabapi.com/marketdata/v1
# OPTIONS_ANALYSIS_SCHWAB_HTTP_MAX_RESPONSE_BYTES=5000000
